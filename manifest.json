{
  "manifest_version": 3,
  "name": "Dyslexia Accessibility Checker",
  "version": "1.0",
  "description": "Analyzes webpages against dyslexia-specific accessibility guidelines.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dyslexia Accessibility Checker"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
